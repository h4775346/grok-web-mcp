{
  "manifest_version": 3,
  "name": "Grok Web MCP",
  "version": "0.5.1",
  "description": "Grok Imagine for any AI agent (Claude, Codex, Gemini, Cursor...): runs jobs from your local grok-web-mcp in your grok.com tab.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://grok.com/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    { "matches": ["https://grok.com/*"], "js": ["content/main.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://grok.com/*"], "js": ["content/relay.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Web MCP",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  }
}
